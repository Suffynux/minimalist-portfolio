# Supabase project (Settings -> API in the dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Postgres password, used only to apply migrations - never at runtime
DATABASE_PASSWORD=

# Salt for hashing submitter IPs. Any long random string: openssl rand -hex 24
SUBMISSION_SALT=
